{
  "name": "trmnl-token-meter",
  "version": "0.5.1",
  "description": "Local AI coding usage collector for the TRMNL Token Meter plugin.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Daniel Munoz",
    "email": "me@danmunoz.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danmunoz/trmnl-token-meter-cli.git"
  },
  "homepage": "https://github.com/danmunoz/trmnl-token-meter-cli#readme",
  "bugs": {
    "url": "https://github.com/danmunoz/trmnl-token-meter-cli/issues"
  },
  "keywords": [
    "trmnl",
    "codex",
    "opencode",
    "usage",
    "tokens",
    "cli"
  ],
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "trmnl-token-meter": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:privacy": "vitest run tests/privacy-canaries.test.ts tests/redact.test.ts",
    "test:pack": "node ./scripts/smoke-pack.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:privacy && pnpm build && pnpm test:pack",
    "test:oracle": "CODEXBAR_ORACLE=on vitest run tests/pricing/codexbar-oracle.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  }
}
